{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(work-.*\\.pdf)",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "inline"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
